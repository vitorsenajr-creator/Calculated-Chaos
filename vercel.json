{
  "functions": {
    "api/narration.js": {
      "maxDuration": 60
    },
    "api/analyze-photo.js": {
      "maxDuration": 60
    },
    "api/ebay-check-sales.js": {
      "maxDuration": 30
    },
    "api/ebay-listing-tools.js": {
      "maxDuration": 60
    },
    "api/ebay-list.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/app",
      "destination": "/app.html"
    }
  ]
}
