// Firestore security rules for Calculated Chaos.
//
// The live rules are the ones in the Firebase Console (Firestore Database →
// Rules); there is no deploy step that reads this file. This is a versioned
// copy: change it here in a PR, then paste the same text into the Console.
//
// Platform admins carry the platformAdmin custom claim in their sign-in
// token (v3.18.1). Only the server sets it (api/_adminClaims.js, from
// PLATFORM_ADMIN_UIDS in api/_firebaseAdmin.js), so it can't be obtained
// by signing up with an admin's email the way the old email list could.
//
// Since v3.18.4 every data access also needs a verified email
// (email_verified in the sign-in token): an unverified address may not even
// belong to the person using it. Pending accounts only touch their own
// users doc, so they can still sign up and wait for approval.
//
// The Live Catalog was removed in v3.19.0 (git tag live-catalog-last). Its
// data (liveSessions, liveItems, options / live_catalog_options) is frozen:
// members no longer read or write it; platform admins still read it, so the
// Developer Panel backup keeps it.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isVerified() {
      return isSignedIn() && request.auth.token.get('email_verified', false) == true;
    }
    function isAdmin() {
      return isVerified() && request.auth.token.get('platformAdmin', false) == true;
    }
    function isApproved() {
      return isVerified() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved';
    }

    // Multi-business (v3.17.0, docs/multi-tenant.md): a member of a
    // business reads and writes its data under businesses/{bizId}/…
    function isMember(bizId) {
      return isApproved() &&
        exists(/databases/$(database)/documents/businesses/$(bizId)/members/$(request.auth.uid));
    }
    // What members read and write.
    function isMemberData(sub) {
      return sub in ['items', 'drafts', 'counters', 'config', 'ebay_error_log', 'ebay_sales', 'expenses', 'trash'];
    }
    // What platform admins read: the member data plus the frozen Live
    // Catalog collections.
    function isBusinessData(sub) {
      return isMemberData(sub) || sub in ['liveSessions', 'liveItems', 'options'];
    }
    // The pre-business root collections (items, drafts, app_config,
    // app_settings, ebay_error_log) are open only to a member of a business
    // that exists and is not live yet (before the switch). Once the business
    // is live, or for an approved account with no business, nobody reads or
    // writes them except platform admins (backup). Before v3.25.5 any
    // approved account could read every business's root data here.
    function rootOpen() {
      let bizId = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('activeBizId', '');
      return isApproved() &&
        bizId != '' &&
        exists(/databases/$(database)/documents/businesses/$(bizId)) &&
        get(/databases/$(database)/documents/businesses/$(bizId)).data.get('live', false) != true;
    }

    // A new account can only create its own doc as 'pending', with only its
    // email and creation time (v3.28.8: before, any field was accepted, so an
    // account could write its own activeBizId or role). Admins may create
    // 'approved' ones, e.g. employee logins. Only admins approve, change
    // roles or delete.
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId &&
        ((request.resource.data.status == 'pending' &&
          request.resource.data.keys().hasOnly(['status', 'email', 'createdAt'])) ||
         (request.resource.data.status == 'approved' && isAdmin()));
      allow update, delete: if isAdmin();
    }

    // Business doc and member list: written only by the server.
    match /businesses/{bizId} {
      allow read: if isMember(bizId) || isAdmin();
      allow write: if false;
      match /members/{uid} {
        allow read: if isMember(bizId) || isAdmin();
        allow write: if false;
      }
      // Pick activity log (v3.27.7): members add entries under their own uid,
      // nobody edits or deletes one; the owner's screen and admins read it.
      match /pick_log/{docId} {
        allow read: if isMember(bizId) || isAdmin();
        allow create: if isMember(bizId) && request.resource.data.uid == request.auth.uid;
      }
      match /{sub}/{docId} {
        allow read, write: if isMemberData(sub) && isMember(bizId);
        // Platform admins read any business's data (Developer Panel backup
        // and eBay errors, v3.17.1); writing stays with the members.
        allow read: if isBusinessData(sub) && isAdmin();
      }
    }

    match /items/{itemId} { allow read: if isAdmin() || rootOpen(); allow write: if rootOpen(); }
    // eBay tokens since v3.16.0: server only (Firebase Admin ignores rules).
    match /ebay_connections/{docId} { allow read, write: if false; }
    match /app_config/{docId} { allow read: if isAdmin() || rootOpen(); allow write: if rootOpen(); }
    // Global (not business data): eBay category lookups shared by everyone.
    match /ebay_category_cache/{docId} { allow read, write: if isApproved(); }
    match /drafts/{draftId} { allow read: if isAdmin() || rootOpen(); allow write: if rootOpen(); }

    // Product-code counter (app_settings/productCodeCounter). Missing before
    // v3.14.2, so every reservation was denied and the app silently fell
    // back to a per-device "max + 1" guess.
    match /app_settings/{docId} { allow read: if isAdmin() || rootOpen(); allow write: if rootOpen(); }

    // eBay error library (src/modules/ebay-error-log.js). Missing before
    // v3.14.2, so nothing was ever saved.
    match /ebay_error_log/{docId} { allow read: if isAdmin() || rootOpen(); allow write: if rootOpen(); }

    // Frozen Live Catalog data (v3.19.0): admins read it for the backup.
    match /liveSessions/{id} { allow read: if isAdmin(); allow write: if false; }
    match /liveItems/{id} { allow read: if isAdmin(); allow write: if false; }
    match /live_catalog_options/{id} { allow read: if isAdmin(); allow write: if false; }

    // AI usage meter (v3.24.5): one doc per user, month, call type and model,
    // written and summed by the server (api/_aiUsage.js) for the Developer
    // Panel's AI usage tab. No client access at all.
    match /ai_usage/{docId} { allow read, write: if false; }
  }
}
